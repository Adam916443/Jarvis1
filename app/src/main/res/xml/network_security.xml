<?xml version="1.0" encoding="utf-8"?>
<!-- Only HTTPS, only the system's trusted certificates: nothing can be read or altered on Wi-Fi. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
